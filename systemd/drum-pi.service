[Unit]
Description=drum-pi LED driver for the drumui learning kit
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/drum-pi serve --port 9090
Restart=on-failure
RestartSec=2

# Run as a regular user that's a member of the gpio group so rppal can
# access /dev/gpiochip0 without root. Adjust the user name to whatever you
# created on the Pi.
User=pi
Group=gpio

# Tighten privileges — no need for filesystem writes outside /dev.
ProtectSystem=strict
ProtectHome=true
NoNewPrivileges=true

# Stream logs to journalctl
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
